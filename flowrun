#!/usr/bin/env bash
# flowrun - the execution environment for OPM: run a workflow script or a
# single command with the flowrun directives. Scripts can also load them with:
# source flowrun.bash

# flowrun --library: the library's path, for source "$(flowrun --library)";
# answered before anything is loaded
if [[ "${1:-}" == --library ]]; then
  echo "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/flowrun.sh"
  exit 0
fi

_FLOWRUN_CLI=true  # workflow mode is turned on below, after the options
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/flowrun.sh" || exit 1

flowrun::cli_help() {
  echo "flowrun $_FLOWRUN_VERSION - the execution environment for OPM (Open Porous Media)"
  cat << 'HELP_EOF'

Usage: flowrun [OPTIONS] script [args...]
       flowrun [OPTIONS] -c command [args...]
       flowrun [OPTIONS] --shell
       flowrun [OPTIONS] --jobs[=all]

Runs a bash script, with its arguments as $1, $2, ..., or with -c a single
command; both use the directives below. Options are defaults for every
directive.

Directives (scripts and commands run locally; only @submit uses the scheduler;
@help @NAME shows a directive's options, its --NAME-options and settings):
HELP_EOF
  flowrun::directive_help
  cat << 'HELP_EOF'

OPTIONS:
  -c, --command             Run the remaining arguments as a command
  -n, --np PROCESSES        Default number of processes (default: 1)
  -q, --queue QUEUE         Default queue name (default: the scheduler's default)
  -s, --scheduler NAME      Scheduler: auto (default) or localq; lsf, slurm and
                            pbs are planned (--dry-run only in this release)
  --depends-on JOBID[,...]  Make submitted jobs wait until these jobs complete
                            (repeatable; all must complete successfully)
  --localq-options OPTS     Native options for every job of that scheduler:
  --lsf-options OPTS        localq takes --time, --nice, --job-name and
  --slurm-options OPTS      --exclusive; the others pass theirs to bsub, sbatch
  --pbs-options OPTS        or qsub (planned); ignored for jobs sent elsewhere
  --<directive>-options OPTS  Options for every invocation of a directive, e.g.
                            --flow-options, --mpi-options (@help @NAME)
  --directives PATH         Load extension directives from a directory or file
  --<setting> VALUE         Settings of directives, e.g. --flow-version (@help @NAME)
  --dry-run                 Check the workflow and print the jobs it would
                            submit; submits, waits for and runs nothing
  --shell                   Start an interactive bash with the directives, the
                            options applied, Tab completion and job notices
  --jobs[=all]              List pending/running jobs (all: include finished)
  --library                 Print the library's path (source "$(flowrun --library)");
                            must be the first argument
  --version                 Print flowrun's version (with its Git commit, in a
                            checkout that is not exactly a release)
  -h, --help                Show this help message

Options given to @submit (-n, -q, --scheduler, --depends-on,
--<scheduler>-options, -o OUTPUT) override or add to flowrun's.
Option strings use shell quoting: -o "--a='x y' --b=2".

EXAMPLES:
  flowrun -n 4 -c @mpi @flow CASE.DATA         # Flow here, on 4 MPI ranks
  flowrun -c @wait @submit @flow CASE.DATA     # as a job of the local queue
  flowrun --flow-version 2025.04 workflow.sh   # a workflow, with that Flow
  flowrun --dry-run -s slurm workflow.sh       # the jobs it would submit
  flowrun --jobs                               # the local queue's jobs
  flowrun -c @flow -l                          # the Flow versions found
  flowrun --shell                              # an interactive shell

Scripts can also load the directives themselves, to run without flowrun:
  source flowrun.bash; flowrun::setup [OPTIONS]

HELP_EOF
  echo "Full reference: $(flowrun::man_command)"
  echo
}

# Parse the command line and set up the run: handles --help/--jobs and errors,
# applies the workflow options (flowrun::setup_option), and leaves the mode
# (command or script) in _FLOWRUN_MODE and the command or script with its
# arguments in _FLOWRUN_ARGS
flowrun::cli_main() {
  local command_mode=false jobs="" shell=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--command)
        command_mode=true
        shift
        break
        ;;
      --jobs)
        jobs=active
        shift
        ;;
      --jobs=all)
        jobs=all
        shift
        ;;
      --shell)
        shell=true
        shift
        ;;
      -h|--help)
        flowrun::cli_help
        exit 0
        ;;
      --version)
        echo "flowrun $(flowrun::version)"
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        flowrun::setup_option "$@" || exit 1
        if [[ "$_FLOWRUN_SHIFT" -gt 0 ]]; then
          shift "$_FLOWRUN_SHIFT"
        elif [[ "$1" == -* ]]; then
          flowrun::error "Unknown option: $1 (flowrun -h for help)"
          exit 1
        else
          break
        fi
        ;;
    esac
  done

  # An interactive bash with the directives; the options were applied above
  # and reach it as exported settings
  if $shell; then
    if [[ $# -gt 0 || "$command_mode" == true || -n "$jobs" ]]; then
      flowrun::error "--shell starts an interactive shell: no script, -c or --jobs"
      exit 1
    fi
    exec "$BASH" --rcfile "$FLOWRUN_HOME/lib/shell_rc.sh" -i
  fi

  if [[ -n "$jobs" ]]; then
    local scheduler
    scheduler=$(flowrun::get_scheduler) || exit 1
    flowrun::load_queue_backend "$scheduler" || exit 1
    flowrun::backend_list_jobs "$jobs"
    exit
  fi

  if [[ $# -eq 0 ]]; then
    if [[ "$command_mode" == true ]]; then
      flowrun::error "Command required after -c"
    else
      flowrun::error "Script or -c command required"
    fi
    flowrun::cli_help
    exit 1
  fi

  if [[ "$command_mode" == true ]]; then
    _FLOWRUN_MODE=command
  elif [[ -f "$1" ]]; then
    _FLOWRUN_MODE=script
  else
    flowrun::error "Script not found: $1"
    exit 1
  fi
  _FLOWRUN_ARGS=("$@")
}

flowrun::cli_main "$@"
set -- "${_FLOWRUN_ARGS[@]}"
unset _FLOWRUN_ARGS

flowrun::workflow_mode

# Run the command or script here, at the top level rather than inside a
# function, so that the workflow's variables are ordinary globals
if [[ "$_FLOWRUN_MODE" == command ]]; then
  "$@"
else
  # Shift the script off first: without arguments, source keeps the current
  # positional parameters, and the script would see itself as $1
  _FLOWRUN_SCRIPT=$1
  shift
  source "$_FLOWRUN_SCRIPT" "$@"
fi
exit
