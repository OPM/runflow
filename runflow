# runflow - the execution environment for OPM: run a workflow script or a
# single command with the runflow directives. Scripts can also load them with:
# source runflow.bash

# runflow --library: the library's path, for source "$(runflow --library)";
# answered before anything is loaded
if [[ "${1:-}" == --library ]]; then
  echo "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/runflow.sh"
  exit 0
fi

_RUNFLOW_CLI=true  # workflow mode is turned on below, after the options
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/runflow.sh" || exit 1

runflow::cli_help() {
  echo "runflow $_RUNFLOW_VERSION - the execution environment for OPM (Open Porous Media)"
  cat << 'HELP_EOF'

Usage: runflow [OPTIONS] script [args...]
       runflow [OPTIONS] -c command [args...]
       runflow [OPTIONS] --shell
       runflow [OPTIONS] --jobs[=all]

Runs a bash script, with its arguments as $1, $2, ..., or with -c a single
command; both use the directives below. Options are defaults for every
directive.

Directives (scripts and commands run locally; only @submit uses the scheduler;
@help @NAME shows a directive's options, its --NAME-options and settings):
HELP_EOF
  runflow::directive_help
  cat << 'HELP_EOF'

OPTIONS:
  -c, --command             Run the remaining arguments as a command
  -n, --np PROCESSES        Default number of processes (default: 1)
  -q, --queue QUEUE         Default queue name (default: the scheduler's default)
  -s, --scheduler NAME      Scheduler: auto (default) or localq; lsf, slurm and
                            pbs are planned (--dry-run only in this release)
  --depends-on JOBID[,...]  Make submitted jobs wait until these jobs complete
                            (repeatable; all must complete successfully)
  --localq-options OPTS     Native options for every job of that scheduler:
  --lsf-options OPTS        localq takes --time, --nice, --job-name and
  --slurm-options OPTS      --exclusive; the others pass theirs to bsub, sbatch
  --pbs-options OPTS        or qsub (planned); ignored for jobs sent elsewhere
  --<directive>-options OPTS  Options for every invocation of a directive, e.g.
                            --flow-options, --mpi-options (@help @NAME)
  --directives PATH         Load extension directives from a directory or file
  --<setting> VALUE         Settings of directives, e.g. --flow-version (@help @NAME)
  --dry-run                 Check the workflow and print the jobs it would
                            submit; submits, waits for and runs nothing
  --shell                   Start an interactive bash with the directives, the
                            options applied, Tab completion and job notices
  --jobs[=all]              List pending/running jobs (all: include finished)
  --library                 Print the library's path (source "$(runflow --library)");
                            must be the first argument
  --version                 Print runflow's version (with its Git commit, in a
                            checkout that is not exactly a release)
  -h, --help                Show this help message

Options given to @submit (-n, -q, --scheduler, --depends-on,
--<scheduler>-options, -o OUTPUT) override or add to runflow's.
Option strings use shell quoting: -o "--a='x y' --b=2".

EXAMPLES:
  runflow -n 4 -c @mpi @flow CASE.DATA         # Flow here, on 4 MPI ranks
  runflow -c @wait @submit @flow CASE.DATA     # as a job of the local queue
  runflow --flow-version 2025.04 workflow.sh   # a workflow, with that Flow
  runflow --dry-run -s slurm workflow.sh       # the jobs it would submit
  runflow --jobs                               # the local queue's jobs
  runflow -c @flow -l                          # the Flow versions found
  runflow --shell                              # an interactive shell

Scripts can also load the directives themselves, to run without runflow:
  source runflow.bash; runflow::setup [OPTIONS]

HELP_EOF
  echo "Full reference: $(runflow::man_command)"
  echo
}

# Parse the command line and set up the run: handles --help/--jobs and errors,
# applies the workflow options (runflow::setup_option), and leaves the mode
# (command or script) in _RUNFLOW_MODE and the command or script with its
# arguments in _RUNFLOW_ARGS
runflow::cli_main() {
  local command_mode=false jobs="" shell=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--command)
        command_mode=true
        shift
        break
        ;;
      --jobs)
        jobs=active
        shift
        ;;
      --jobs=all)
        jobs=all
        shift
        ;;
      --shell)
        shell=true
        shift
        ;;
      -h|--help)
        runflow::cli_help
        exit 0
        ;;
      --version)
        echo "runflow $(runflow::version)"
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        runflow::setup_option "$@" || exit 1
        if [[ "$_RUNFLOW_SHIFT" -gt 0 ]]; then
          shift "$_RUNFLOW_SHIFT"
        elif [[ "$1" == -* ]]; then
          runflow::error "Unknown option: $1 (runflow -h for help)"
          exit 1
        else
          break
        fi
        ;;
    esac
  done

  # An interactive bash with the directives; the options were applied above
  # and reach it as exported settings
  if $shell; then
    if [[ $# -gt 0 || "$command_mode" == true || -n "$jobs" ]]; then
      runflow::error "--shell starts an interactive shell: no script, -c or --jobs"
      exit 1
    fi
    exec "$BASH" --rcfile "$RUNFLOW_HOME/lib/shell_rc.sh" -i
  fi

  if [[ -n "$jobs" ]]; then
    local scheduler
    scheduler=$(runflow::get_scheduler) || exit 1
    runflow::load_queue_backend "$scheduler" || exit 1
    runflow::backend_list_jobs "$jobs"
    exit
  fi

  if [[ $# -eq 0 ]]; then
    if [[ "$command_mode" == true ]]; then
      runflow::error "Command required after -c"
    else
      runflow::error "Script or -c command required"
    fi
    runflow::cli_help
    exit 1
  fi

  if [[ "$command_mode" == true ]]; then
    _RUNFLOW_MODE=command
  elif [[ -f "$1" ]]; then
    _RUNFLOW_MODE=script
  else
    runflow::error "Script not found: $1"
    exit 1
  fi
  _RUNFLOW_ARGS=("$@")
}

runflow::cli_main "$@"
set -- "${_RUNFLOW_ARGS[@]}"
unset _RUNFLOW_ARGS

runflow::workflow_mode

# Run the command or script here, at the top level rather than inside a
# function, so that the workflow's variables are ordinary globals
if [[ "$_RUNFLOW_MODE" == command ]]; then
  "$@"
else
  # Shift the script off first: without arguments, source keeps the current
  # positional parameters, and the script would see itself as $1
  _RUNFLOW_SCRIPT=$1
  shift
  source "$_RUNFLOW_SCRIPT" "$@"
fi
exit
